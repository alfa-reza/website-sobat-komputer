{
  "name": "website-sobat-komputer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:css": "sass --silence-deprecation=import,global-builtin,color-functions,if-function assets/scss/framework.scss assets/css/framework.css --style=compressed --no-source-map",
    "build": "npm run build:css && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "jsdom": "^31.0.0",
    "sass": "^1.94.0",
    "vite": "^6.4.1"
  }
}
